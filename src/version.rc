#include <winver.h>
#include "version.h"

#define SHIM_VER_NUM  SHIM_VERSION_MAJOR,SHIM_VERSION_MINOR,SHIM_VERSION_PATCH,0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SHIM_VER_NUM
 PRODUCTVERSION SHIM_VER_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vietcong community"
            VALUE "FileDescription",  "Vietcong DirectPlay host-fix shim"
            VALUE "FileVersion",      SHIM_VERSION_STR
            VALUE "InternalName",     "dpnet"
            VALUE "LegalCopyright",   "LGPL-2.1-or-later"
            VALUE "OriginalFilename", "dpnet.dll"
            VALUE "ProductName",      "vietcong-directplay-hostfix"
            VALUE "ProductVersion",   SHIM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
